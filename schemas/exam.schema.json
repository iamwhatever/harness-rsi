{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamwhatever/harness-rsi/schemas/exam.schema.json",
  "description": "One exam item. Every item must be decidable by the judge through its check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layer", "origin", "visibility", "task", "check", "created_round", "used_rounds"],
  "properties": {
    "id": {"type": "string", "pattern": "^exam_[a-z0-9_]+$"},
    "layer": {"description": "1 hard metrics, 2 real pain, 3 external seed, 4 human taste.", "type": "integer", "minimum": 1, "maximum": 4},
    "origin": {
      "description": "Signal ids this exam came from. Empty only for layer-1 metrics.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sig_[0-9]{8}_[0-9]{4}$"}
    },
    "visibility": {"enum": ["hidden", "regression", "retired"]},
    "task": {"type": "string", "minLength": 1},
    "check": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"enum": ["exit_code", "file_assert", "metric_threshold", "screenshot_diff"]}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "exit_code"}}}, "then": {"$ref": "#/$defs/exit_code"}},
        {"if": {"properties": {"kind": {"const": "file_assert"}}}, "then": {"$ref": "#/$defs/file_assert"}},
        {"if": {"properties": {"kind": {"const": "metric_threshold"}}}, "then": {"$ref": "#/$defs/metric_threshold"}},
        {"if": {"properties": {"kind": {"const": "screenshot_diff"}}}, "then": {"$ref": "#/$defs/screenshot_diff"}}
      ]
    },
    "created_round": {"type": "integer", "minimum": 0},
    "used_rounds": {
      "description": "Rounds this exam scored in. A hidden exam is used at most once.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "allOf": [
    {"if": {"properties": {"visibility": {"const": "hidden"}}}, "then": {"properties": {"used_rounds": {"maxItems": 1}}}},
    {"if": {"properties": {"layer": {"minimum": 2}}}, "then": {"properties": {"origin": {"minItems": 1}}}}
  ],
  "$defs": {
    "exit_code": {
      "additionalProperties": false,
      "required": ["kind", "cmd", "expect"],
      "properties": {
        "kind": true,
        "cmd": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expect": {"type": "integer"},
        "timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "file_assert": {
      "additionalProperties": false,
      "required": ["kind", "path"],
      "minProperties": 3,
      "properties": {
        "kind": true,
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contains": {"type": "string", "minLength": 1}
      }
    },
    "metric_threshold": {
      "additionalProperties": false,
      "required": ["kind", "metric", "stat", "op", "value", "runs"],
      "properties": {
        "kind": true,
        "metric": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "stat": {"enum": ["p50", "p95", "mean", "rate"]},
        "op": {"enum": ["lt", "le", "gt", "ge"]},
        "value": {"type": "number"},
        "runs": {"type": "integer", "minimum": 1}
      }
    },
    "screenshot_diff": {
      "additionalProperties": false,
      "required": ["kind", "baseline", "max_diff_ratio"],
      "properties": {"kind": true, "baseline": {"type": "string", "minLength": 1}, "max_diff_ratio": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}
