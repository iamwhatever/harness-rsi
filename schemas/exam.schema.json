{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamwhatever/harness-rsi/schemas/exam.schema.json",
  "description": "One exam item. Every item must be decidable by the judge through its check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layer", "origin", "visibility", "task", "check", "created_round", "used_rounds"],
  "properties": {
    "id": {"type": "string", "pattern": "^exam_[a-z0-9_]+$"},
    "layer": {"description": "1 hard metrics, 2 real pain, 3 external seed, 4 human taste.", "type": "integer", "minimum": 1, "maximum": 4},
    "origin": {
      "description": "Signal ids this exam came from. Empty only for layer-1 metrics.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sig_[0-9]{8}_[0-9]{4}$"}
    },
    "visibility": {"enum": ["hidden", "regression", "retired"]},
    "task": {"type": "string", "minLength": 1},
    "check": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"enum": ["exit_code", "file_assert", "metric_threshold", "screenshot_diff", "dom_assert"]}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "exit_code"}}}, "then": {"$ref": "#/$defs/exit_code"}},
        {"if": {"properties": {"kind": {"const": "file_assert"}}}, "then": {"$ref": "#/$defs/file_assert"}},
        {"if": {"properties": {"kind": {"const": "metric_threshold"}}}, "then": {"$ref": "#/$defs/metric_threshold"}},
        {"if": {"properties": {"kind": {"const": "screenshot_diff"}}}, "then": {"$ref": "#/$defs/screenshot_diff"}},
        {"if": {"properties": {"kind": {"const": "dom_assert"}}}, "then": {"$ref": "#/$defs/dom_assert"}}
      ]
    },
    "created_round": {"type": "integer", "minimum": 0},
    "used_rounds": {
      "description": "Rounds this exam scored in. A hidden exam is used at most once.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "allOf": [
    {"if": {"properties": {"visibility": {"const": "hidden"}}}, "then": {"properties": {"used_rounds": {"maxItems": 1}}}},
    {"if": {"properties": {"layer": {"minimum": 2}}}, "then": {"properties": {"origin": {"minItems": 1}}}}
  ],
  "$defs": {
    "exit_code": {
      "additionalProperties": false,
      "required": ["kind", "cmd", "expect"],
      "properties": {
        "kind": true,
        "cmd": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expect": {"type": "integer"},
        "timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "file_assert": {
      "additionalProperties": false,
      "required": ["kind", "path"],
      "minProperties": 3,
      "properties": {
        "kind": true,
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contains": {"type": "string", "minLength": 1}
      }
    },
    "metric_threshold": {
      "additionalProperties": false,
      "required": ["kind", "metric", "stat", "op", "value", "runs"],
      "properties": {
        "kind": true,
        "metric": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "stat": {"enum": ["p50", "p95", "mean", "rate"]},
        "op": {"enum": ["lt", "le", "gt", "ge"]},
        "value": {"type": "number"},
        "runs": {"type": "integer", "minimum": 1}
      }
    },
    "screenshot_diff": {
      "additionalProperties": false,
      "required": ["kind", "baseline", "max_diff_ratio"],
      "properties": {"kind": true, "baseline": {"type": "string", "minLength": 1}, "max_diff_ratio": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "dom_assert": {
      "description": "Open the built SPA under `root` at `path`, run `setup`, then read the first `selector` match: it must contain `text` or match `regex`.",
      "additionalProperties": false,
      "required": ["kind", "path", "selector"],
      "oneOf": [{"required": ["text"]}, {"required": ["regex"]}],
      "properties": {
        "kind": true,
        "root": {"description": "SPA dir relative to the workdir, holding index.html. Default `.`.", "type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "selector": {"description": "CSS selector.", "type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "regex": {"type": "string", "minLength": 1},
        "timeout_s": {"type": "integer", "minimum": 1},
        "setup": {
          "description": "`route` and `storage` apply before the page loads; `click`, `fill`, `wait_for` run in order after it loads.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false, "required": ["route"],
                "properties": {"route": {"description": "/api path; a trailing * matches a prefix.", "type": "string", "pattern": "^/api/"}, "json": true, "status": {"type": "integer"}}
              },
              {"type": "object", "additionalProperties": false, "required": ["storage"], "properties": {"storage": {"type": "object", "additionalProperties": {"type": "string"}}}},
              {"type": "object", "additionalProperties": false, "required": ["click"], "properties": {"click": {"type": "string", "minLength": 1}}},
              {"type": "object", "additionalProperties": false, "required": ["fill"], "properties": {"fill": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}}},
              {"type": "object", "additionalProperties": false, "required": ["wait_for"], "properties": {"wait_for": {"type": "string", "minLength": 1}}}
            ]
          }
        }
      }
    }
  }
}
