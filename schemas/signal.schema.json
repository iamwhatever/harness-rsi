{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamwhatever/harness-rsi/schemas/signal.schema.json",
  "description": "One row of the signal list. Summary and links only, never copied message text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "links", "pain", "mentions", "layer", "testable", "dedup_of"],
  "properties": {
    "id": {"$ref": "#/$defs/signal_id"},
    "source": {
      "description": "Origin, keyed by a stable id (Slack channel id, not its name).",
      "type": "string",
      "pattern": "^(slack|github|session|trend):[^\\s]+$"
    },
    "links": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
    "pain": {"type": "string", "minLength": 1, "maxLength": 200},
    "mentions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "people", "window_days"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "people": {"type": "integer", "minimum": 1},
        "window_days": {"type": "integer", "minimum": 1}
      }
    },
    "layer": {"enum": ["real", "external"]},
    "testable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "task"],
      "properties": {"ok": {"type": "boolean"}, "task": {"type": ["string", "null"], "minLength": 1}},
      "if": {"properties": {"ok": {"const": true}}},
      "then": {"properties": {"task": {"type": "string"}}}
    },
    "dedup_of": {"description": "Id of the signal this one was merged into, or null.", "anyOf": [{"$ref": "#/$defs/signal_id"}, {"type": "null"}]}
  },
  "$defs": {"signal_id": {"type": "string", "pattern": "^sig_[0-9]{8}_[0-9]{4}$"}}
}
